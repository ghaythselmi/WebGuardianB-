<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Reset your WebGuardian password</title></head>
<body style="margin:0;padding:32px 12px;background:#f3f6fb;font-family:Arial,Helvetica,sans-serif;color:#17243a;">
  <div style="max-width:600px;margin:0 auto;background:#fff;border:1px solid #e5eaf2;border-radius:18px;overflow:hidden;">
    <div style="padding:28px 36px;background:#101c36;color:#fff;">
      <div style="font-size:13px;font-weight:bold;letter-spacing:2px;color:#53d9e9;">WEBGUARDIAN</div>
      <h1 style="margin:20px 0 0;font-size:26px;line-height:1.25;">Reset your password</h1>
    </div>
    <div style="padding:36px;">
      <p style="margin:0 0 16px;font-size:16px;line-height:1.6;">Hi {{ username|e }},</p>
      <p style="margin:0 0 24px;color:#526178;font-size:15px;line-height:1.7;">We received a request to change the password for your WebGuardian account. Use the button below to choose a new password.</p>
      <p style="margin:0 0 28px;"><a href="{{ resetUrl|e('html_attr') }}" style="display:inline-block;padding:14px 24px;border-radius:9px;background:#1769e0;color:#fff;text-decoration:none;font-size:15px;font-weight:bold;">Choose a new password</a></p>
      <p style="margin:0 0 12px;color:#526178;font-size:14px;line-height:1.7;">This link expires in {{ expiresInMinutes }} minutes and can only be used once.</p>
      <p style="margin:0;color:#7b8799;font-size:13px;line-height:1.7;">If the button doesn’t work, copy and paste this address into your browser:<br><a href="{{ resetUrl|e('html_attr') }}" style="color:#1769e0;word-break:break-all;">{{ resetUrl|e }}</a></p>
      <div style="margin-top:28px;padding-top:20px;border-top:1px solid #e8edf4;color:#7b8799;font-size:13px;line-height:1.6;">If you didn’t request a password change, you can ignore this email. Your current password will remain unchanged.</div>
    </div>
  </div>
  <p style="max-width:600px;margin:18px auto 0;text-align:center;color:#8a95a5;font-size:12px;">WebGuardian · Website monitoring and alerts</p>
</body>
</html>
